{:paths ["src"]
 ;; The canonical IPLD DAG-CBOR layer: multiformats supplies CIDv1 assembly,
 ;; dag-cbor supplies canonical CBOR + generic tags (>= 9c60d58, the first
 ;; SHA with major-type-6 support); this repo owns the tag-42 link discipline.
 :deps {io.github.kotoba-lang/io-multiformats {:git/sha "b3b157e683a943d4f2e9362d9366cceefff3f656"}
        io.github.kotoba-lang/org-ietf-cbor {:git/sha "1dacfc40c77573e3f4553093de0e0000f18a7c08"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
