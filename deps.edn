{:paths ["src" "resources"]
 ;; The canonical IPLD DAG-CBOR layer: multiformats supplies CIDv1 assembly,
 ;; dag-cbor supplies canonical CBOR + generic tags (>= 9c60d58, the first
 ;; SHA with major-type-6 support); this repo owns the tag-42 link discipline.
 :deps {io.github.kotoba-lang/io-multiformats {:git/sha "c5963264a8da78ece878b04da18225abdbb84457"}
        io.github.kotoba-lang/org-ietf-cbor {:git/sha "1dacfc40c77573e3f4553093de0e0000f18a7c08"}
        ;; `ipld.dag-pb` decodes with the workspace's protobuf wire codec.
        ;; It encodes without it: DAG-PB writes field 2 before field 1 and
        ;; emits a default-valued Name, and a deterministic protobuf encoder
        ;; correctly refuses to do either.
        io.github.kotoba-lang/dev-protobuf {:git/sha "cfd0b29997abbcae918ec5e90fddd621dbfb97b6"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
