{:paths ["src" "resources"]
 ;; The canonical IPLD DAG-CBOR layer: multiformats supplies CIDv1 assembly,
 ;; dag-cbor supplies canonical CBOR + generic tags (>= 9c60d58, the first
 ;; SHA with major-type-6 support); this repo owns the tag-42 link discipline.
 :deps {
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "0ffd5f6340af50871d4759b06e02ac4fbf9a4bdf"}
        ;; kotoba.lang.edn replaced clojure.edn / cljs.reader here (2026-09-24, owner
        ;; instruction "clojure.* は kotoba.* にしてね"). kotoba.lang.edn, not the
        ;; kotoba.edn facade: the compiler (amu) links kotoba.lang.edn and excludes
        ;; the edn-* definition repos kotoba.edn assembles. 79dba32 = edn main.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/io-multiformats
        ;; Floor, not a preference. That SHA adds `install-sha256!`, the seam a
        ;; host uses to supply its own digest. `get-verified-block` re-derives a
        ;; CID for every block a traversal touches, and the portable digest is
        ;; ~500x slower than the host's: measured compiled, 384 KB took 117 ms
        ;; here and 0.17 ms through `node:crypto`. Below this SHA a consumer
        ;; cannot install one, whatever its host has.
        ;; 2026-09-25: 721281d2 (was 64ea18ed, which it contains): base32's
        ;; Kotoba reading, which ipld.link's typed half decodes CIDs with.
        {:git/sha "721281d20525dc4d9af0064862d1c35226065ce2"}
        ;; 2026-09-25: a09268f8 (was 1dacfc40, which it contains): cbor.core's
        ;; typed encoder (encode-tag / encode-bytes), which ipld.link's
        ;; link-fragment is built on (adr-2609242330 S1c).
        io.github.kotoba-lang/org-ietf-cbor {:git/sha "a09268f8227a8c9b1ce145fa57b244af2ebe7d5e"}
        ;; `ipld.dag-pb` decodes with the workspace's protobuf wire codec.
        ;; It encodes without it: DAG-PB writes field 2 before field 1 and
        ;; emits a default-valued Name, and a deterministic protobuf encoder
        ;; correctly refuses to do either.
        io.github.kotoba-lang/dev-protobuf {:git/sha "cfd0b29997abbcae918ec5e90fddd621dbfb97b6"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
